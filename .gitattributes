# LF everywhere, on every platform. The corpus/goldens/determinism guarantees
# are byte-level; Windows CRLF checkout translation would silently change
# fixture bytes (shas, goldens) per platform.
* text=auto eol=lf

# Explicit binary guards — never subject to any text handling.
*.png binary
*.gif binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.docx binary
*.bin binary

# fux: the committed index merges line by line, never textually.
.fux/index/*.jsonl merge=fux-index
.fux/index/REGISTER merge=fux-index
.fux/index/sections/*.jsonl merge=fux-index

# lockmaster:begin — written by `lockmaster drivers` from lockmaster.toml [merge]; edit that, not this
work/WORKLOG.md merge=lockmaster-append-newest-first
work/LESSONS.md merge=lockmaster-append-newest-first
work/IMPLEMENTATION.md merge=lockmaster-append-newest-first
work/OPEN-WORK.md merge=lockmaster-table-rows
work/BACKLOG.md merge=lockmaster-table-rows
archive/README.md merge=lockmaster-table-rows
# lockmaster:end
